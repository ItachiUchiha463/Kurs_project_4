# Скопіюйте у .env і заповніть (POSTGRES_PASSWORD і JWT_SECRET обов'язкові). Файл .env у git не потрапляє (ТЗ, розд. 16).
# Згенерувати випадковий секрет: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- База даних ---
POSTGRES_USER=vigil
POSTGRES_PASSWORD=
POSTGRES_DB=vigil
# з хоста; у Compose бекенд бере адресу db:5432 зі своїх environment
DATABASE_URL=postgresql+asyncpg://vigil:ПАРОЛЬ_ІЗ_POSTGRES_PASSWORD@localhost:5433/vigil

# --- Безпека ---
# обов'язково, щонайменше 32 символи: без нього сервіс не стартує
JWT_SECRET=
# Fernet-ключ для облікових даних /metrics: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Втратити його = ввести ці облікові дані заново, тож збережіть копію в менеджері паролів.
SECRETS_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=vigil_monitor_bot

# --- Сервіс ---
# Домен для HTTPS (Caddy). Локально лишіть localhost.
DOMAIN=localhost
PUBLIC_URL=https://vigil-demo.westeurope.cloudapp.azure.com
REGISTRATION_MODE=open
METRICS_RETENTION_DAYS=30
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Ліміти (ТЗ 2.4) ---
QUOTA_TARGETS=20
GLOBAL_USERS=100
