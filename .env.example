# Скопіюйте у .env і заповніть. Файл .env у git не потрапляє (ТЗ, розд. 16).
# Згенерувати випадковий секрет: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- База даних ---
POSTGRES_USER=vigil
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vigil
# з хоста; у Compose бекенд бере адресу db:5432 зі своїх environment
DATABASE_URL=postgresql+asyncpg://vigil:change-me@localhost:5433/vigil

# --- Безпека ---
JWT_SECRET=change-me-48-random-chars
# Fernet-ключ для облікових даних /metrics: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Втратити його = ввести ці облікові дані заново, тож збережіть копію в менеджері паролів.
SECRETS_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=vigil_monitor_bot

# --- Сервіс ---
# Домен для HTTPS (Caddy). Локально лишіть localhost.
DOMAIN=localhost
PUBLIC_URL=https://vigil-demo.westeurope.cloudapp.azure.com
REGISTRATION_MODE=open
METRICS_RETENTION_DAYS=30
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Квоти користувача (ТЗ 2.4) ---
QUOTA_TARGETS=20
QUOTA_RULES=50
QUOTA_SERIES=500
QUOTA_DISCOVERED=100
QUOTA_PROM_SERIES=50
QUOTA_MIN_INTERVAL_S=15

# --- Загальні ліміти сервісу (ТЗ 2.4) ---
GLOBAL_SERIES=2000
GLOBAL_USERS=100
GLOBAL_REGISTRATIONS_PER_IP_DAY=3
